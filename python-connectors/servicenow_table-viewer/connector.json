{
    "meta" : {
        "label": "ServiceNow table to dataset",
        "description": "",
        "icon": "icon-ticket dku-icon-servicenow"
    },
    "readable": true,
    "writable": false,
    "params": [
        {
            "name": "auth_type",
            "label": "Authentication type",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": "basic_per_user",
                    "label": "User account"
                },
                {
                    "value": "basic_service_account",
                    "label": "Service account"
                },
                {
                    "value": "oauth_service_account",
                    "label": "OAuth service account"
                },
                {
                    "value": "oauth_sso",
                    "label": "OAuth SSO"
                }
            ]
        },
        {
            "name": "basic_per_user",
            "label": "Per user",
            "type": "PRESET",
            "parameterSetId": "basic-per-user",
            "visibilityCondition": "model.auth_type=='basic_per_user'"
        },
        {
            "name": "basic_service_account",
            "label": "Service account",
            "type": "PRESET",
            "parameterSetId": "basic-service-account",
            "visibilityCondition": "model.auth_type=='basic_service_account'"
        },
        {
            "name": "oauth_service_account",
            "label": "OAuth service account",
            "type": "PRESET",
            "parameterSetId": "oauth-service-account",
            "visibilityCondition": "model.auth_type=='oauth_service_account'"
        },
        {
            "name": "oauth_sso",
            "label": "OAuth SSO",
            "type": "PRESET",
            "parameterSetId": "oauth-sso",
            "visibilityCondition": "model.auth_type=='oauth_sso'"
        },
        {
            "name": "endpoint",
            "label": "Table",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": "incident",
                    "label": "Incidents"
                },
                {
                    "value": "concoursepicker",
                    "label": "Course picker"
                },
                {
                    "value": "change",
                    "label": "Changes"
                },
                {
                    "value": "catalogmanagement",
                    "label": "Catalog"
                },
                {
                    "value": "problem",
                    "label": "Problems"
                },
                {
                    "value": "caller_id",
                    "label": "Caller ID"
                },
                {
                    "value": "sys_db_object",
                    "label": "List all tables"
                },
                {
                    "value": "sys_app_category",
                    "label": "Categories"
                },
                {
                    "value": "catalog_category_request",
                    "label": "Catalog category"
                },
                {
                    "value": "_dku_manual_setting",
                    "label": "✍️ Enter manually"
                }
            ]
        },
        {
            "name": "table_name",
            "label": "Table name",
            "type": "STRING",
            "visibilityCondition": "model.endpoint=='_dku_manual_setting'"
        },
        {
            "name": "display_values",
            "label": " ",
            "description": "Display values",
            "type": "BOOLEAN",
            "defaultValue": true
        },
        {
            "name": "advanced_parameters",
            "label": " ",
            "description": "Advanced parameters",
            "type": "BOOLEAN",
            "defaultValue": false
        },
        {
            "name": "sysparm_query",
            "label": "sysparm_query",
            "type": "STRING",
            "description": "Optional ServiceNow query string passed to the API",
            "defaultValue": "ORDERBYDESCsys_created_on",
            "visibilityCondition": "model.advanced_parameters==true"
        },
        {
            "name": "sysparm_fields",
            "label": "sysparm_fields",
            "type": "STRING",
            "description": "Optional comma-separated list of fields to return",
            "visibilityCondition": "model.advanced_parameters==true"
        },
        {
            "name": "page_size",
            "label": "Page size",
            "type": "INT",
            "defaultValue": 10000,
            "description": "Page size for paginated API calls",
            "visibilityCondition": "model.advanced_parameters==true"
        }
    ]
}
