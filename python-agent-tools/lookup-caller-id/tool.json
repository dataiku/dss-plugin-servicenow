{
    "id": "lookup-servicenow-caller-id",
    "meta": {
        "icon": "icon-ticket dku-icon-servicenow",
        "label": "Lookup caller ID",
        "description": "Find the ID of a ServiceNow user"
    },
    
    "params" : [
        {
            "name": "auth_type",
            "label": "Authentication type",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": "basic_per_user",
                    "label": "User account"
                },
                {
                    "value": "basic_service_account",
                    "label": "Service account"
                },
                {
                    "value": "oauth_service_account",
                    "label": "OAuth service account"
                },
                {
                    "value": "oauth_password_grant",
                    "label": "OAuth password grant"
                },
                {
                    "value": "oauth_sso",
                    "label": "OAuth SSO"
                }
            ]
        },
        {
            "name": "basic_per_user",
            "label": "Per user",
            "type": "PRESET",
            "parameterSetId": "basic-per-user",
            "visibilityCondition": "model.auth_type=='basic_per_user'"
        },
        {
            "name": "basic_service_account",
            "label": "Service account",
            "type": "PRESET",
            "parameterSetId": "basic-service-account",
            "visibilityCondition": "model.auth_type=='basic_service_account'"
        },
        {
            "name": "oauth_service_account",
            "label": "OAuth service account",
            "type": "PRESET",
            "parameterSetId": "oauth-service-account",
            "visibilityCondition": "model.auth_type=='oauth_service_account'"
        },
        {
            "name": "oauth_password_grant",
            "label": "OAuth Password Grant",
            "type": "PRESET",
            "parameterSetId": "password-grant-flow",
            "visibilityCondition": "model.auth_type=='oauth_password_grant'"
        },
        {
            "name": "oauth_sso",
            "label": "OAuth SSO",
            "type": "PRESET",
            "parameterSetId": "oauth-sso",
            "visibilityCondition": "model.auth_type=='oauth_sso'"
        }
    ]
}